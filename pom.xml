<?xml version="1.0" encoding="UTF-8"?>
<!--
  Week 5: microservices (was Week 4: service-based architecture).

  This is now a PARENT pom (packaging "pom"): it builds nothing itself, it just
  lists the modules and fixes the versions they all share. Each service is its
  own Spring Boot jar (its own deployable unit, started as its own process),
  and the two library modules (catalog-client, shared-web) are plain jars
  compiled into the services that need them.

    catalog-client     the catalog interface + an HTTP client for catalog-service
    shared-web         the error JSON shape and the domain errors it maps (incl. 503)
    catalog-service    GET /items                                  :8081
    checkout-service   POST /transactions/**, GET /transactions/** :8082
    inventory-service  GET /inventory/low-stock                    :8083
    analytics-service  GET /analytics/popular-items                :8084

  The gateway on :8080 is nginx (gateway/nginx.conf), not a module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.selfcheckout</groupId>
	<artifactId>self-checkout</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<modules>
		<module>catalog-client</module>
		<module>shared-web</module>
		<module>catalog-service</module>
		<module>checkout-service</module>
		<module>inventory-service</module>
		<module>analytics-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<archunit.version>1.3.0</archunit.version>
	</properties>

	<!-- One place for the versions of our own libraries, so every service
	     depends on exactly the same build of them. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.selfcheckout</groupId>
				<artifactId>catalog-client</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.selfcheckout</groupId>
				<artifactId>shared-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
