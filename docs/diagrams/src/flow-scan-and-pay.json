{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "One Customer: Start, Scan, Pay",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      650
    ],
    "legend": {
      "mode": "hidden"
    }
  },
  "participants": [
    {
      "id": "station",
      "type": "external",
      "label": "Station",
      "sublabel": "via nginx :8080"
    },
    {
      "id": "checkout",
      "type": "backend",
      "label": "checkout-service",
      "sublabel": ":8082"
    },
    {
      "id": "basket",
      "type": "backend",
      "label": "OpenBasket",
      "sublabel": "in memory"
    },
    {
      "id": "db",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "shared database"
    }
  ],
  "segments": [
    {
      "from": 176,
      "to": 348,
      "label": "Start + scan: memory only, no SQL"
    },
    {
      "from": 378,
      "to": 570,
      "label": "Pay: one database transaction"
    }
  ],
  "messages": [
    {
      "id": "start",
      "from": "station",
      "to": "checkout",
      "y": 196,
      "label": "POST /transactions",
      "variant": "emphasis"
    },
    {
      "id": "open",
      "from": "checkout",
      "to": "basket",
      "y": 224,
      "label": "open basket"
    },
    {
      "id": "started",
      "from": "checkout",
      "to": "station",
      "y": 252,
      "label": "201 transactionId",
      "variant": "return"
    },
    {
      "id": "scan",
      "from": "station",
      "to": "checkout",
      "y": 280,
      "label": "POST …/items (each scan)",
      "variant": "emphasis"
    },
    {
      "id": "addline",
      "from": "checkout",
      "to": "basket",
      "y": 308,
      "label": "add line, price from cache"
    },
    {
      "id": "scanned",
      "from": "checkout",
      "to": "station",
      "y": 336,
      "label": "200 running total",
      "variant": "return"
    },
    {
      "id": "pay",
      "from": "station",
      "to": "checkout",
      "y": 392,
      "label": "POST …/complete",
      "variant": "emphasis"
    },
    {
      "id": "header",
      "from": "checkout",
      "to": "db",
      "y": 420,
      "label": "BEGIN · INSERT transactions"
    },
    {
      "id": "lock",
      "from": "checkout",
      "to": "db",
      "y": 448,
      "label": "SELECT … ORDER BY sku FOR NO KEY UPDATE",
      "variant": "security"
    },
    {
      "id": "stock",
      "from": "checkout",
      "to": "db",
      "y": 476,
      "label": "UPDATE items.stock · INSERT transaction_items"
    },
    {
      "id": "alerts",
      "from": "checkout",
      "to": "db",
      "y": 504,
      "label": "INSERT low_stock_alerts (if crossed)",
      "variant": "dashed"
    },
    {
      "id": "commit",
      "from": "checkout",
      "to": "db",
      "y": 532,
      "label": "COMMIT · item locks released",
      "variant": "emphasis"
    },
    {
      "id": "receipt",
      "from": "checkout",
      "to": "station",
      "y": 560,
      "label": "200 receipt",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "checkout",
      "from": 196,
      "to": 566,
      "type": "backend"
    },
    {
      "participant": "basket",
      "from": 219,
      "to": 314,
      "type": "backend"
    },
    {
      "participant": "db",
      "from": 415,
      "to": 538,
      "type": "database"
    }
  ]
