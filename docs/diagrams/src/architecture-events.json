  "cards": [
    {
      "dot": "emerald",
      "title": "Own data store each",
      "items": [
        "four databases on one PostgreSQL server",
        "a role can open its own database only",
        "no service calls another: only the broker"
      ]
    },
    {
      "dot": "cyan",
      "title": "Events through RabbitMQ",
      "items": [
        "payment: StockCommitRequested -> StockCommitted",
        "scans: ScansRecorded batches, numbered by analytics",
        "startup: CatalogRequested -> CatalogPublished (fanout)"
      ]
    },
    {
      "dot": "rose",
      "title": "Saga over events",
      "items": [
        "checkout orchestrates; ack only after commit + reply",
        "idempotent on transaction id and batch id",
        "not queued: 503 + reopen; maybe queued: resolver"
      ]
    }
  ]
