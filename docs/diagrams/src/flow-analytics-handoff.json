  "cards": [
    {
      "dot": "emerald",
      "title": "Gapless by construction",
      "items": [
        "one thread assigns seq, at batch time",
        "batch N+1 only after batch N commits",
        "a failed INSERT retries with the same seqs"
      ]
    },
    {
      "dot": "cyan",
      "title": "Never blocks a scan",
      "items": [
        "the scan only offers to a bounded queue",
        "if full: dropped and counted (0 in every run)",
        "analytics lag: mean ≤161, max ≤689 scans"
      ]
    },
    {
      "dot": "amber",
      "title": "Restart-safe",
      "items": [
        "checkout resumes numbering at MAX(seq) + 1",
        "analytics reloads its window from scan_log",
        "check-windows.sql recounts every window"
      ]
    }
  ]
