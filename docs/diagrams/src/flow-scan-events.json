  "cards": [
    {
      "dot": "emerald",
      "title": "Gapless, no duplicates",
      "items": [
        "analytics numbers seq in the same transaction",
        "a redelivered batch hits its batchId and is skipped",
        "acked only after the commit"
      ]
    },
    {
      "dot": "cyan",
      "title": "Never blocks a customer",
      "items": [
        "the scan only offers to a bounded queue",
        "full queue: dropped and counted",
        "broker or analytics down: checkout keeps serving"
      ]
    },
    {
      "dot": "amber",
      "title": "Restart-safe",
      "items": [
        "unconfirmed batch re-sent with the same batchId",
        "batches wait in the durable queue",
        "analytics reloads its window from scan_log"
      ]
    }
