 "cards": [
  {
   "dot": "emerald",
   "title": "HTTP only at the edge",
   "items": [
    "Client \u2192 gateway \u2192 one service is the only HTTP.",
    "Services never call each other: every cross-service step is a message through RabbitMQ."
   ]
  },
  {
   "dot": "orange",
   "title": "Payment saga (bold)",
   "items": [
    "checkout publishes StockCommitRequested; inventory commits, then replies.",
    "Messages are acked only after the database commit."
   ]
  },
  {
   "dot": "violet",
   "title": "Catalog at startup (dashed)",
   "items": [
    "Each service sends CatalogRequested; catalog broadcasts CatalogPublished to all three."
   ]
  }
 ]
