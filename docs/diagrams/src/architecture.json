  "cards": [
    {
      "dot": "emerald",
      "title": "Own data store each",
      "items": [
        "catalog_db, inventory_db, checkout_db, analytics_db",
        "a role can open its own database only",
        "no cross-service joins are possible"
      ]
    },
    {
      "dot": "cyan",
      "title": "Talking over HTTP",
      "items": [
        "checkout → inventory: POST /internal/stock/commit",
        "checkout → analytics: POST /internal/scans",
        "all three others load GET /items from catalog once"
      ]
    },
    {
      "dot": "rose",
      "title": "Payment = saga",
      "items": [
        "checkout orchestrates; inventory's commit is the pivot",
        "idempotent on transaction id; forward recovery",
        "inventory down: 503, basket reopens, stock untouched"
      ]
    }
  ]
