  "cards": [
    {
      "dot": "emerald",
      "title": "One writer per table",
      "items": [
        "checkout writes items.stock, transactions, transaction_items, low_stock_alerts, scan_log",
        "analytics writes popular_snapshots",
        "catalog and inventory only read"
      ]
    },
    {
      "dot": "cyan",
      "title": "Hand-off, not calls",
      "items": [
        "checkout appends every scan to scan_log",
        "analytics polls scan_log by seq",
        "the database is the only coupling"
      ]
    },
    {
      "dot": "rose",
      "title": "Enforced three ways",
      "items": [
        "no service module depends on another",
        "ArchUnit ownership tests",
